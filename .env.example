# ── Option A: OpenAI directly ────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# ── Option B: OpenRouter (any vision model) ──────────────────
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_VISION_MODEL=google/gemini-2.5-pro

# ── Option C: Two-model agentic pipeline (Design B) ──────────
# A STRONGER "cropper" model locates the regions worth reading and crops them;
# a CHEAPER "extractor" model reads the labels out of each crop.
# Set OPENAI_CROP_MODEL to ENABLE this mode. Leave it empty for grid tiling.
#
# OPENAI_CROP_MODEL=google/gemini-2.5-pro        # strong: region cropping (tool calls)
# OPENAI_EXTRACT_MODEL=gpt-4.1-mini              # cheap: reads labels (default: OPENAI_VISION_MODEL)
#
# Optional: point the cropper at a different provider than the extractor.
# OPENAI_CROP_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CROP_API_KEY=sk-or-v1-...
